# Локальный запуск без Docker. Скопируйте файл в .env при необходимости.
# Без переменных БД проект использует SQLite (db.sqlite3).

SECRET_KEY=django-insecure-change-me
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# PostgreSQL (раскомментируйте, если не хотите SQLite):
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=kubkubych
# DB_USER=kubkubych
# DB_PASSWORD=kubkubych_secret
# DB_HOST=127.0.0.1
# DB_PORT=5432

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

EMAIL_HOST=localhost
EMAIL_PORT=1025
DEFAULT_FROM_EMAIL=no-reply@kubkubych.ru
ADMIN_EMAIL=admin@kubkubych.ru

SENTRY_DSN=
SENTRY_ENVIRONMENT=local
SENTRY_TRACES_SAMPLE_RATE=0.1

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/auth/oauth/google/callback/

VK_CLIENT_ID=
VK_CLIENT_SECRET=
VK_REDIRECT_URI=http://127.0.0.1:8000/api/auth/oauth/vk/callback/

JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
