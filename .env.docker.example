# Запуск через docker compose. Скопируйте файл в .env.docker.

SECRET_KEY=django-insecure-change-me-in-docker
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

DB_ENGINE=django.db.backends.postgresql
DB_NAME=kubkubych
DB_USER=kubkubych
DB_PASSWORD=kubkubych_secret
DB_HOST=db
DB_PORT=5432

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

EMAIL_HOST=mailhog
EMAIL_PORT=1025
DEFAULT_FROM_EMAIL=no-reply@kubkubych.ru
ADMIN_EMAIL=admin@kubkubych.ru

SENTRY_DSN=
SENTRY_ENVIRONMENT=docker
SENTRY_TRACES_SAMPLE_RATE=0.2

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/oauth/google/callback/

VK_CLIENT_ID=
VK_CLIENT_SECRET=
VK_REDIRECT_URI=http://localhost:8000/api/auth/oauth/vk/callback/

JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
